<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steamcents.catalog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__REPO__/ops/run_catalog.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- once a day at 04:15. if the mac was asleep launchd runs it on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.catalog.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.catalog.err</string>
</dict>
</plist>
